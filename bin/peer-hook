#!/usr/bin/env python3
"""Local hook adapter. No sockets, subprocesses, or notification delivery."""
import argparse
import json
import sys
from peer_core import hook_deliver, observe, prompt_receipts, note_hook_failure

parser = argparse.ArgumentParser()
parser.add_argument('--kind', choices=('claude', 'codex', 'omo'), required=True)
args = parser.parse_args()
try:
    event = json.load(sys.stdin)
    row = observe(event, args.kind)
    if row and event.get('hook_event_name') == 'StopFailure':
        from peer_delivery import start_worker
        start_worker()  # senders still waiting on this turn must hear why it ended
    if row:
        prompt_receipts(row, event)
        output = hook_deliver(row, event)
        if output:
            print(json.dumps(output, ensure_ascii=False))
except Exception as error:
    note_hook_failure(error)  # A peer observation must never break an agent turn or disclose its prompt.
