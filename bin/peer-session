#!/usr/bin/env python3
"""Run an agent so peer can reach it: `peer run codex [codex args]`, and the launcher behind peer spawn and sm.

A Codex TUI keeps its app-server inside its own process, where nothing outside can talk to it.
This starts one private server for one TUI and attaches the TUI with --remote, so peer can start
or steer turns and read the thread's state. The server belongs to that TUI alone, so restarting a
shared daemon cannot cut it off, and it ends when the TUI exits.

Claude needs no server (its hooks and inbox are enough) and OmO takes mail through peer-omo.js; for
them this only puts peer on PATH and passes the session's identity on."""
import functools
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import threading
import time
from peer_codex import prepare_resume, watch
from peer_core import config, launcher, root
from peer_transport import BIN


def interrupted(signum, frame):
    raise SystemExit(128 + signum)


def config_overrides(args):
    """-c/--config/--enable/--disable pairs. The server builds the thread, so it needs them too:
    given only to a --remote TUI, overrides such as developer_instructions never reach the model."""
    out, i = [], 0
    while i < len(args):
        if args[i] in ('-c', '--config', '--enable', '--disable') and i + 1 < len(args):
            out += args[i:i + 2]; i += 2
        elif args[i].startswith(('--config=', '--enable=', '--disable=')):
            out.append(args[i]); i += 1
        else:
            i += 1
    return out


# Subcommands that open a session TUI take --remote after their own name; every other subcommand
# (exec, login, mcp, ...) is not a session peer could reach, so it runs Codex directly. That keeps
# `alias codex='peer run codex'` (peer install --codex-alias) from changing anything but the TUI.
SESSION_COMMANDS = {'resume', 'fork'}
VALUE_OPTIONS = {'-c', '--config', '-m', '--model', '-p', '--profile', '-s', '--sandbox', '-a', '--ask-for-approval',
                 '-C', '--cd', '-i', '--image', '--enable', '--disable', '--add-dir', '--remote', '--remote-auth-token-env',
                 '--local-provider'}
PASSTHROUGH_FLAGS = {'-h', '--help', '-V', '--version'}


def first_word(args):
    """(index, word) of the first argument that is not an option or an option's value."""
    i = 0
    while i < len(args):
        if args[i] == '--':
            return None, None
        if args[i].startswith('-'):
            i += 2 if args[i] in VALUE_OPTIONS else 1
            continue
        return i, args[i]
    return None, None


BYPASS = {'--dangerously-bypass-approvals-and-sandbox'}


def unattended_resume(args):
    """(thread, args) for a resume that explicitly asks to run without approvals, else (None, args).

    Codex keeps a thread's stored policy when a --remote TUI resumes it and refuses the override there, so the
    policy goes to the server first (prepare_resume) and the override is left out of the TUI's arguments.
    Two spellings: Codex's own `resume THREAD --dangerously-bypass-approvals-and-sandbox`, and `-ry THREAD`
    (or -yr), a wrapper shorthand that sm uses; such a wrapper turns it into a plain remote resume itself."""
    prefix = args[:args.index('--')] if '--' in args else list(args)
    flag = next((i for i, a in enumerate(prefix) if a in ('-ry', '-yr')), None)
    if flag is not None:
        if flag + 1 >= len(prefix) or prefix[flag + 1].startswith('-'):
            raise ValueError('unattended resume needs a thread id: -ry THREAD_ID')
        return prefix[flag + 1], args
    at, word = first_word(prefix)
    if word != 'resume' or not BYPASS.intersection(prefix):
        return None, args
    _, thread = first_word(prefix[at + 1:])
    if not thread:
        return None, args  # `resume --last`: no thread to set; Codex says what it thinks of the flag
    return thread, [a for a in args if a not in BYPASS]


def tui_args(args, sock):
    """Codex's own arguments with --remote placed where that command reads it, or None to run Codex
    as is. A first word that is not a subcommand is the TUI's opening prompt."""
    if PASSTHROUGH_FLAGS.intersection(args):
        return None
    at, word = first_word(args)
    if word in SESSION_COMMANDS:
        return args[:at + 1] + ['--remote', 'unix://' + sock] + args[at + 1:]
    if word is not None and word in codex_subcommands():
        return None
    return ['--remote', 'unix://' + sock] + args


@functools.lru_cache(maxsize=1)
def codex_subcommands():
    """Read from `codex --help` once, so a new subcommand passes through without a peer release.
    A command line is indented two spaces; deeper lines continue the description above."""
    try:
        text = subprocess.run(launcher('codex') + ['--help'], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        text = ''
    words, listing = set(), False
    for line in text.splitlines():
        if line.strip() == 'Commands:':
            listing = True
        elif listing and not line.strip():
            break
        elif listing:
            if line.startswith('  ') and not line.startswith('   '):
                words.add(line.split()[0])
            words.update(a.strip() for a in line.partition('[aliases:')[2].rstrip(']').split(',') if a.strip())
    return words or {'exec', 'e', 'review', 'login', 'logout', 'mcp', 'mcp-server', 'app-server', 'completion', 'apply', 'a',
                     'sandbox', 'debug', 'cloud', 'features', 'help', 'update', 'doctor'}


def agent_env():
    """This environment, marked as launched by peer (a wrapper that hands interactive starts to peer-session
    must not do it again), with peer on PATH: an agent started from an app with a bare PATH must still be
    able to run peer. Appended, so nothing the caller chose is shadowed."""
    env = dict(os.environ, PEER_LAUNCHED='1')
    path = env.get('PATH', '').split(':')
    for folder in (str(BIN), str(Path.home() / '.local/bin')):
        if folder not in path and Path(folder).is_dir():
            path.append(folder)
    env['PATH'] = ':'.join(p for p in path if p)
    return env


def main(args):
    if tui_args(args, '') is None:
        os.execvp(launcher('codex')[0], launcher('codex') + args)
    signal.signal(signal.SIGHUP, interrupted)
    signal.signal(signal.SIGTERM, interrupted)
    stopped = threading.Event()
    server = None
    thread, args = unattended_resume(args)
    # /tmp keeps the socket path under macOS's 104-byte limit; a longer one fails to bind.
    with tempfile.TemporaryDirectory(prefix='peer-codex-', dir='/tmp') as temp:
        sock = str(Path(temp) / 'c.sock')
        env = dict(agent_env(), PEER_CODEX_SOCKET=sock)
        server = subprocess.Popen([os.environ.get('PEER_CODEX_BIN', 'codex'), 'app-server', '--listen', 'unix://' + sock]
                                  + config_overrides(args),
                                  env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            for _ in range(100):
                if Path(sock).exists():
                    break
                if server.poll() is not None:
                    sys.exit('peer: codex app-server exited during startup')
                time.sleep(.1)
            if thread:
                prepare_resume(sock, thread)
            threading.Thread(target=watch, args=(server, sock, stopped), daemon=True).start()
            result = subprocess.run(launcher('codex') + tui_args(args, sock), env=env)
        finally:
            stopped.set()
            server.terminate()
            try:
                server.wait(timeout=5)
            except subprocess.TimeoutExpired:
                server.kill()
                server.wait()
    return result.returncode


def run_claude(args):
    return subprocess.run(launcher('claude') + args, env=agent_env()).returncode


def run_omo(args):
    """OmO runs the session in an RPC host that receives only OMO_*/SENPI_*/PI_* and a few basics, so the
    identity peer-omo.js needs travels packed into one OMO_ variable. Without it the extension stays off."""
    env = agent_env()
    keys = ('PEER_NAME', 'PEER_HOLD_SOCK', 'PEER_PARENT', 'PEER_VISIBLE', 'SM_PANE_ID', 'SM_WORKSPACE')
    identity = {k: env[k] for k in keys if env.get(k)}
    identity.update(PEER_BIN=str(BIN), PEER_STATE=str(root()), PEER_CONFIG=str(config()))
    env['OMO_PEER_IDENTITY'] = json.dumps(identity)
    return subprocess.run(launcher('omo') + args, env=env).returncode


if __name__ == '__main__':
    run = {'codex': main, 'claude': run_claude, 'omo': run_omo}.get(sys.argv[1] if len(sys.argv) > 1 else '')
    if not run:
        sys.exit('usage: peer run codex [codex args]')
    signal.signal(signal.SIGHUP, interrupted)
    signal.signal(signal.SIGTERM, interrupted)
    try:
        sys.exit(run(sys.argv[2:]))
    except ValueError as error:
        sys.exit('peer: ' + str(error))
